    {
      "dot": "emerald",
      "title": "Orchestration",
      "items": [
        "PLUGIN_FACTORIES dispatches inspire, generic, and oai_pmh per repository",
        "Repositories run concurrently; one failure does not stop the others",
        "Plugins yield HarvestedArc; upload stays in the harvester core"
      ]
    },
    {
      "dot": "cyan",
      "title": "Plugins",
      "items": [
        "INSPIRE: CSW GetRecords → DataMapper → ARC JSON",
        "Generic: Protocol → PayloadParser → DataMapper",
        "OAI-PMH: ListRecords → PayloadParser → DataMapper"
      ]
    },
    {
      "dot": "amber",
      "title": "Publish",
      "items": [
        "ApiClient.harvest_arcs creates a harvest, streams ARCs, then completes it",
        "api_client config (URL, mTLS paths) lives on the harvester, not on plugins"
      ]
    }

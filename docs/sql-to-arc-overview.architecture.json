  "cards": [
    {
      "dot": "emerald",
      "title": "Batch conversion",
      "items": [
        "Runs at the RDI: SQL views → ARC RO-Crate JSON-LD → Middleware API",
        "process_investigations drives builds and harvest upload concurrently",
        "HarvestReport is printed as JSON-LD on stdout when the run finishes"
      ]
    },
    {
      "dot": "cyan",
      "title": "SQL contract",
      "items": [
        "ARC/ISA mapping is owned by the RDI SQL views; the converter is mostly plumbing",
        "Required views: vInvestigation, vStudy, vAssay, vContact, vPublication, vAnnotationTable",
        "SchemaValidator checks columns before streaming (Postgres, MySQL/MariaDB, Oracle, MSSQL)"
      ]
    },
    {
      "dot": "amber",
      "title": "Workers + publish",
      "items": [
        "ProcessPoolHolder runs build_single_arc_task in spawn workers",
        "Builder maps rows via ARCtrl and returns RO-Crate JSON strings",
        "ApiClient.harvest_arcs streams built ARCs under mTLS"
      ]
    }
  ]
